<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>JumperBho</AssemblyName>
    <RootNamespace>JumperBho</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Makes every public type COM-visible by default is normally OFF; we opt in
         per-class instead (see [ComVisible(true)] on BhoObject) for clarity. -->
    <ComVisible>false</ComVisible>

    <!-- We're not GAC-installing this or strong-naming it - regasm /codebase is fine
         for a local POC. Silences the "no strong name" build warning noise. -->
    <NoWarn>CS8021</NoWarn>

    <!-- Needed for System.Windows.Forms.Control, used purely as a cheap way to
         marshal calls from the background named-pipe listener thread back onto
         the STA thread that owns the live COM objects (Control.Invoke posts a
         message the control's HWND message loop - which IE-mode's host process
         is already pumping - picks up and runs the delegate on). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wire protocol shared with JumperNativeHost. Linked, not project-
         referenced: the two assemblies are deployed and registered completely
         independently, so neither should depend on the other's binary.
         CHANGING IT MEANS REBUILDING BOTH PROJECTS. -->
    <Compile Include="..\shared\BridgeProtocol.cs" Link="BridgeProtocol.cs" />
  </ItemGroup>

</Project>

