{
  "manifest_version": 3,
  "name": "Jumper Bridge (POC)",
  "version": "1.1.0",
  "description": "Bridges the modern Gecko web app to Chameleon using shared-session navigation, a compact launcher, and Namer integration.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://chsw.tasmc.corp/*",
    "https://inextdata.tasmc.corp/*",
    "https://dev-inextdata.tasmc.corp/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://inextdata.tasmc.corp/*",
        "https://dev-inextdata.tasmc.corp/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["page-window-open-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://inextdata.tasmc.corp/*",
        "https://dev-inextdata.tasmc.corp/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_signal_urls",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Jumper Bridge (POC)"
  },
  "options_ui": {
    "page": "diagnostics.html",
    "open_in_tab": true
  }
}
