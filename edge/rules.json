[
  {
    "id": 1,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "requestDomains": ["chsw"],
      "resourceTypes": ["main_frame", "sub_frame", "xmlhttprequest", "ping", "other"]
    }
  },
  {
    "comment": "The side panel hosts the modern app in an iframe. Framing is normally refused by X-Frame-Options / CSP frame-ancestors, so strip those - but ONLY for sub_frame requests to our own first-party app, never for top-level navigations or any other origin.",
    "id": 2,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "x-frame-options", "operation": "remove" },
        { "header": "content-security-policy", "operation": "remove" },
        { "header": "content-security-policy-report-only", "operation": "remove" }
      ]
    },
    "condition": {
      "requestDomains": ["inextdata.tasmc.corp", "dev-inextdata.tasmc.corp"],
      "resourceTypes": ["sub_frame"]
    }
  }
]
